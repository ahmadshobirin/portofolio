{
  "name": "vite-vue-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:isadev": "cross-env BUILD_BASE=/ vue-tsc -b && cross-env BUILD_BASE=/ vite build",
    "build:root": "cross-env BUILD_BASE=/ vue-tsc -b && cross-env BUILD_BASE=/ vite build",
    "preview": "vite preview",
    "preview:root": "cross-env BUILD_BASE=/ vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy:userpages": "npm run build:isadev && gh-pages -d dist -r https://github.com/ahmadshobirin/ahmadshobirin.github.io.git",
    "deploy:userpages:master": "npm run build:root && cp README.dist.md dist/README.md && gh-pages -d dist -r https://github.com/ahmadshobirin/ahmadshobirin.github.io.git -b master"
  },
  "dependencies": {
    "vue": "^3.4.38",
    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.1.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "vue-tsc": "2.0.29",
    "typescript": "5.6.2",
    "vite": "^5.4.10",
    "autoprefixer": "^10.4.18",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.35",
    "gh-pages": "^6.1.1",
    "@types/node": "^20.11.30"
    ,
    "cross-env": "^7.0.3"
  }
}